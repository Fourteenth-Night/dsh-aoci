{
  "name": "dsh-aoci",
  "version": "0.1.8",
  "description": "AOCI 认知层：为 DeepSeek Harness 提供全仓库代码/数据库认知地图（dsh-mcp-client 桥接 + 索引治理 + 只读面板）。基于 AOCI-CODE（github.com/aoci-spec/aoci-code），不捆绑其二进制。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.mjs",
    "lib/client.js",
    "lib/**/*.js.map",
    "lib/**/*.jsx",
    "lib/skill/SKILL.md",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "RELEASE.md",
    "docs/DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "compatibility": {
      "desktop": { "range": ">=2.7.0 <4.0.0", "api": "^1.2.0" },
      "runtime": { "range": "^0.1.1-rc.1 || ^0.1.5-alpha.1" },
      "surfaces": ["main"]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.5-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-mcp-client": { "optional": true },
    "@deepseek-ai/dsh-api-gateway": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true }
  },
  "dependencies": { "schemastery": "^3.18.0", "@modelcontextprotocol/sdk": "^1.12.0" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack": "npm run build && npm pack"
  },
  "license": "MIT"
}